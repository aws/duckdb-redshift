# name: test/mock/secret.test
# description: there is no `redshift` secret type: an ATTACH's configuration is its options
# group: [mock]

require-env REDSHIFT_TEST_CLIENT mock

require redshift

# The type is not registered. An ATTACH takes its configuration as options or a path, and SECRET
# names a DuckDB aws or s3 secret (attach.test).
statement error
CREATE SECRET rs_cfg (TYPE redshift, REGION 'us-east-1', CREDENTIAL_PROVIDER aws_default_chain);
----
Secret type "redshift" not found

query I
SELECT count(*) FROM duckdb_secret_types() WHERE type = 'redshift';
----
0
