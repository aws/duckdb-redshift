Redshift handle "rs_direct" cannot be browsed as a catalog

# USE probes for the schema without requiring it, so the refusal is DuckDB's own; it still fails.
statement error
USE rs_direct;
----
No catalog + schema named "rs_direct" found

# Nor can the search path name a schema of the handle, which the catalog relies on to recognize a
# two-part reference by its default schema.
statement error
SET search_path = 'rs_direct.main';
----
No catalog + schema named "rs_direct.main" found

# CONNECT, new in DuckDB v2.0, is not catalog access either: it sends each statement to Redshift as
# its text (test/mock/connect.test), so DuckDB resolves no name through the handle.
statement ok
CONNECT rs_direct;

statement ok
DISCONNECT;

# What else a non-browsable handle costs, besides `<handle>.<file>` above.

# It lists no tables.
query I
SELECT count(*) FROM (SHOW TABLES FROM rs_direct);
----
0

# A table alias with the handle's name binds to the table, not to the handle.
statement ok
CREATE TABLE rs_alias_t AS SELECT 1 AS a;

query I
SELECT rs_direct.a FROM rs_alias_t AS rs_direct;
----
1

statement ok
DROP TABLE rs_alias_t;

# A dot call on a column of such an alias fails while the handle refuses every lookup, since DuckDB
# first looks the function up in the handle. Calling the function directly works.
statement error
SELECT rs_direct.a.upper() FROM (SELECT 'x' AS a) AS rs_direct;
----
Redshift handle "rs_direct" cannot be browsed as a catalog

query T
SELECT upper(rs_direct.a) FROM (SELECT 'x' AS a) AS rs_direct;
----
X

# So does a two-part dot call on a column named like the handle, which fails with any catalog of
# that name. upper(rs_direct) works.
statement error
SELECT rs_direct.upper() FROM (SELECT 'x' AS rs_direct);
----
Redshift handle "rs_direct" cannot be browsed as a catalog

query T
SELECT upper(rs_direct) FROM (SELECT 'x' AS rs_direct);
----
X

# A local schema with the handle's name makes `<name>.<table>` ambiguous, as it does for any
# catalog of that name. The fully qualified local name still works.
statement ok
CREATE SCHEMA memory.rs_direct;

statement ok
CREATE TABLE memory.rs_direct.t AS SELECT 1 AS a;

statement error
SELECT a FROM rs_direct.t;
----
Ambiguous reference to catalog or schema "rs_direct"

query I
SELECT a FROM memory.rs_direct.t;
----
1

statement ok
DROP SCHEMA memory.rs_direct CASCADE;

# ---------------------------------------------------------------------------
# DuckDB's own options are accepted, as for any attached database. A handle has no default table,
# so a reference DuckDB resolves through DEFAULT_TABLE fails, whether or not a local table or view
# has the handle's name. A local one is then reached through its schema.
# ---------------------------------------------------------------------------

# A local table with the handle's name: DuckDB checks the handle's default table for ambiguity.
statement ok
CREATE TABLE rs_dt_local AS SELECT 1 AS i;

statement ok
ATTACH '' AS rs_dt_local (TYPE redshift, REGION 'us-east-1', CREDENTIAL_PROVIDER aws_default_chain, WORKGROUP 'wg', ACCOUNT_ID '012345678901', DEFAULT_TABLE 'x');

statement error
SELECT i FROM rs_dt_local;
----
Catalog Error: Redshift handle "rs_dt_local" has no default table; query it with redshift_query('rs_dt_local', ...). For a local table "rs_dt_local", qualify it with its schema

query I
SELECT i FROM main.rs_dt_local;
----
1

statement ok
DETACH rs_dt_local;

# Without DEFAULT_TABLE, the local table is read as usual.
statement ok
ATTACH '' AS rs_dt_local (TYPE redshift, REGION 'us-east-1', CREDENTIAL_PROVIDER aws_default_chain, WORKGROUP 'wg', ACCOUNT_ID '012345678901');

query I
SELECT i FROM rs_dt_local;
----
1

# ATTACH IF NOT EXISTS sets DEFAULT_TABLE on the existing handle without running the attach
# callback; the reference fails the same way.
statement ok
ATTACH IF NOT EXISTS '' AS rs_dt_local (TYPE redshift, REGION 'us-east-1', CREDENTIAL_PROVIDER aws_default_chain, WORKGROUP 'wg', ACCOUNT_ID '012345678901', DEFAULT_TABLE 'x');

statement error
SELECT i FROM rs_dt_local;
----
Redshift handle "rs_dt_local" has no default table

statement ok
DETACH rs_dt_local;

statement ok
DROP TABLE rs_dt_local;

# No local table with the handle's name: DuckDB falls back to the handle's default table.
statement ok
ATTACH '' AS rs_dt (TYPE redshift, REGION 'us-east-1', CREDENTIAL_PROVIDER aws_default_chain, WORKGROUP 'wg', ACCOUNT_ID '012345678901', DEFAULT_TABLE 'x');

statement error
SELECT * FROM rs_dt;
----
Catalog Error: Redshift handle "rs_dt" has no default table

statement ok
DETACH rs_dt;

# HIDDEN takes effect; RECOVERY_MODE and VACUUM_REBUILD_INDEXES are accepted and have nothing to
# apply to.
statement ok
ATTACH '' AS rs_hidden (TYPE redshift, REGION 'us-east-1', CREDENTIAL_PROVIDER aws_default_chain, WORKGROUP 'wg', ACCOUNT_ID '012345678901', HIDDEN);

query I
SELECT count(*) FROM duckdb_databases() WHERE database_name = 'rs_hidden';
----
0

statement ok
DETACH rs_hidden;

statement ok
ATTACH '' AS rs_opts (TYPE redshift, REGION 'us-east-1', CREDENTIAL_PROVIDER aws_default_chain, WORKGROUP 'wg', ACCOUNT_ID '012345678901', RECOVERY_MODE 'no_wal_writes', VACUUM_REBUILD_INDEXES 1);

statement ok
DETACH rs_opts;

# ---------------------------------------------------------------------------
# DuckDB transactions. A refused lookup in the handle is a catalog error. Since DuckDB v2.0 any
# error aborts an explicit transaction by default (default_transaction_invalidation_policy is
# ALL_ERRORS_INVALIDATE_TRANSACTION), so the refusal behaves like every other error: the local
# work is lost and COMMIT ends the transaction without keeping it. Under
# SYNTACTIC_ERRORS_DO_NOT_INVALIDATE, v1.5's behaviour, the refusal leaves the transaction usable:
# COMMIT keeps and ROLLBACK discards the local work around it.
# ---------------------------------------------------------------------------
statement ok
BEGIN;

statement ok
CREATE TABLE aborted AS SELECT 1 AS i;

statement error
SELECT * FROM rs_direct.public.users;
----
cannot be browsed as a catalog

statement error
SELECT 1;
----
Current transaction is aborted

statement ok
COMMIT;

statement ok
SET default_transaction_invalidation_policy = 'SYNTACTIC_ERRORS_DO_NOT_INVALIDATE';

statement ok
BEGIN;

statement error
SELECT * FROM rs_direct.public.users;
----
cannot be browsed as a catalog

statement ok
CREATE TABLE committed AS SELECT 1 AS i;

statement ok
COMMIT;

statement ok
BEGIN;

statement error
SELECT * FROM rs_direct.public.users;
----
cannot be browsed as a catalog

statement ok
CREATE TABLE rolled_back AS SELECT 1 AS i;

statement ok
ROLLBACK;

statement ok
RESET default_transaction_invalidation_policy;

query T
SELECT table_name FROM duckdb_tables() WHERE table_name IN ('aborted', 'committed', 'rolled_back');
----
committed

statement ok
DETACH rs_direct;

statement ok
DETACH rs_profile;
