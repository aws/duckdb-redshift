Redshift handle "rs_direct" cannot be browsed as a catalog

# An unquoted file name that starts with the handle's name, such as rs_direct.csv, parses like any
# two-part reference to the handle, which DuckDB checks before reading it as a file. So every
# two-part reference is refused with a hint to quote it, in case it is a file.
statement error
SELECT * FROM rs_direct.csv;
----
Catalog Error: Redshift handle "rs_direct" cannot be browsed as a catalog: catalog access is not available. Query Redshift through the handle with redshift_query('rs_direct', '<Redshift SQL>'). If rs_direct.csv is a file, quote it like 'rs_direct.csv'

statement error
SELECT * FROM rs_direct.users;
----
If rs_direct.users is a file, quote it like 'rs_direct.users'

# A three-part reference gets no hint.
statement error
SELECT * FROM rs_direct.public.users;
----
<!REGEX>:(?s).*is a file.*

# Quoted, it is read as a file, as without a handle.
statement ok
COPY (SELECT 1 AS a) TO '{TEST_DIR}/rs_direct.csv';

query I
SELECT a FROM '{TEST_DIR}/rs_direct.csv';
----
1

statement error
CREATE TABLE rs_direct.public.t (i INTEGER);
