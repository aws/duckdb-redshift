# name: test/client/sql/credential_literal_diagnostic.test
# description: live: a COPY or UNLOAD the server refuses after a credential shows none of it, but an unclosed literal
# group: [sql]

require-env REDSHIFT_TEST_CLIENT odbc

# Live only: it needs REDSHIFT_TEST_LIVE_REGION, the region of a workgroup this process's default
# AWS credential chain can reach, and a build with a driver.
require-env REDSHIFT_TEST_LIVE_REGION

# The account-backed workgroup the live tests reach (test/README.md, "Live variables").
require-env REDSHIFT_TEST_LIVE_WORKGROUP

require-env REDSHIFT_TEST_LIVE_ACCOUNT_ID

require redshift

statement ok
CALL enable_logging(level = 'debug');

statement ok
ATTACH '' AS rs (TYPE redshift, REGION '{REDSHIFT_TEST_LIVE_REGION}', CREDENTIAL_PROVIDER aws_default_chain, WORKGROUP '{REDSHIFT_TEST_LIVE_WORKGROUP}', ACCOUNT_ID '{REDSHIFT_TEST_LIVE_ACCOUNT_ID}');

# Each statement fails to parse at the stray parenthesis after its credential, so none runs. The
# server's message echoes a part of the statement up to and including that parenthesis "in context",
# keyword and literal, on the first line, the one the client shows: the literal shows as the
# redaction marker. The first block of each pair finds no PLACEHOLDER_ canary anywhere in the error,
# which holds only while DuckDB's own location of the redshift_query call stops before the literal;
# the second pins the server's line and its SQLSTATE, then that location.

statement error
SELECT * FROM redshift_query('rs', 'COPY placeholder_table FROM ''s3://placeholder-bucket/key'' SECRET_ACCESS_KEY ''PLACEHOLDER_SECRET_KEY'' )');
----
<!REGEX>:(?s).*PLACEHOLDER_.*

statement error
SELECT * FROM redshift_query('rs', 'COPY placeholder_table FROM ''s3://placeholder-bucket/key'' SECRET_ACCESS_KEY ''PLACEHOLDER_SECRET_KEY'' )');
----
<REGEX>:(?s)Binder Error: Redshift refused the statement: ERROR:  syntax error at or near "\)" in context "[^\n]* SECRET_ACCESS_KEY '<redacted>' \)", at line 1\nSQLSTATE: 42601\n\nLINE 1: .*

statement error
SELECT * FROM redshift_query('rs', 'COPY placeholder_table FROM ''s3://placeholder-bucket/key'' SESSION_TOKEN ''PLACEHOLDER_SESSION_TOKEN'' )');
----
<!REGEX>:(?s).*PLACEHOLDER_.*

statement error
SELECT * FROM redshift_query('rs', 'COPY placeholder_table FROM ''s3://placeholder-bucket/key'' SESSION_TOKEN ''PLACEHOLDER_SESSION_TOKEN'' )');
----
<REGEX>:(?s)Binder Error: Redshift refused the statement: ERROR:  syntax error at or near "\)" in context "[^\n]* SESSION_TOKEN '<redacted>' \)", at line 1\nSQLSTATE: 42601\n\nLINE 1: .*

# In a CREDENTIALS string the value runs to the next ';' or the line's end, so the rest of the line
# goes with it.
statement error
SELECT * FROM redshift_query('rs', 'COPY placeholder_table FROM ''s3://placeholder-bucket/key'' CREDENTIALS ''aws_iam_role=placeholder;aws_secret_access_key=PLACEHOLDER_SECRET_KEY;token=PLACEHOLDER_TOKEN'' )');
----
<!REGEX>:(?s).*PLACEHOLDER_.*

statement error
SELECT * FROM redshift_query('rs', 'COPY placeholder_table FROM ''s3://placeholder-bucket/key'' CREDENTIALS ''aws_iam_role=placeholder;aws_secret_access_key=PLACEHOLDER_SECRET_KEY;token=PLACEHOLDER_TOKEN'' )');
----
<REGEX>:(?s)Binder Error: Redshift refused the statement: ERROR:  syntax error at or near "\)" in context "[^\n]* CREDENTIALS 'aws_iam_role=placeholder;aws_secret_access_key=<redacted>;token=<redacted>\nSQLSTATE: 42601\n\nLINE 1: .*

statement error
SELECT * FROM redshift_query('rs', 'COPY placeholder_table FROM ''s3://placeholder-bucket/key'' CREDENTIALS ''aws_iam_role=placeholder;master_symmetric_key=PLACEHOLDER_MASTER_KEY'' )');
----
<!REGEX>:(?s).*PLACEHOLDER_.*

statement error
SELECT * FROM redshift_query('rs', 'COPY placeholder_table FROM ''s3://placeholder-bucket/key'' CREDENTIALS ''aws_iam_role=placeholder;master_symmetric_key=PLACEHOLDER_MASTER_KEY'' )');
----
<REGEX>:(?s)Binder Error: Redshift refused the statement: ERROR:  syntax error at or near "\)" in context "[^\n]* CREDENTIALS 'aws_iam_role=placeholder;master_symmetric_key=<redacted>\nSQLSTATE: 42601\n\nLINE 1: .*

# MASTER_SYMMETRIC_KEY's literal is refused before the parenthesis is read, with a message that echoes
# nothing of the statement.
statement error
SELECT * FROM redshift_query('rs', 'COPY placeholder_table FROM ''s3://placeholder-bucket/key'' MASTER_SYMMETRIC_KEY ''PLACEHOLDER_MASTER_KEY'' )');
----
<!REGEX>:(?s).*PLACEHOLDER_.*

statement error
SELECT * FROM redshift_query('rs', 'COPY placeholder_table FROM ''s3://placeholder-bucket/key'' MASTER_SYMMETRIC_KEY ''PLACEHOLDER_MASTER_KEY'' )');
----
<REGEX>:(?s)Binder Error: Redshift refused the statement: ERROR:  Client side encryption is deprecated for COPY command\nSQLSTATE: 0A000\n\nLINE 1: .*

# The same forms in an UNLOAD.
statement error
SELECT * FROM redshift_query('rs', 'UNLOAD (''SELECT 1'') TO ''s3://placeholder-bucket/prefix'' SECRET_ACCESS_KEY ''PLACEHOLDER_SECRET_KEY'' )');
----
<!REGEX>:(?s).*PLACEHOLDER_.*

statement error
SELECT * FROM redshift_query('rs', 'UNLOAD (''SELECT 1'') TO ''s3://placeholder-bucket/prefix'' SECRET_ACCESS_KEY ''PLACEHOLDER_SECRET_KEY'' )');
----
<REGEX>:(?s)Binder Error: Redshift refused the statement: ERROR:  syntax error at or near "\)" in context "[^\n]* SECRET_ACCESS_KEY '<redacted>' \)", at line 1\nSQLSTATE: 42601\n\nLINE 1: .*

statement error
SELECT * FROM redshift_query('rs', 'UNLOAD (''SELECT 1'') TO ''s3://placeholder-bucket/prefix'' SESSION_TOKEN ''PLACEHOLDER_SESSION_TOKEN'' )');
----
<!REGEX>:(?s).*PLACEHOLDER_.*

statement error
SELECT * FROM redshift_query('rs', 'UNLOAD (''SELECT 1'') TO ''s3://placeholder-bucket/prefix'' SESSION_TOKEN ''PLACEHOLDER_SESSION_TOKEN'' )');
----
<REGEX>:(?s)Binder Error: Redshift refused the statement: ERROR:  syntax error at or near "\)" in context "[^\n]* SESSION_TOKEN '<redacted>' \)", at line 1\nSQLSTATE: 42601\n\nLINE 1: .*

statement error
SELECT * FROM redshift_query('rs', 'UNLOAD (''SELECT 1'') TO ''s3://placeholder-bucket/prefix'' CREDENTIALS ''aws_iam_role=placeholder;aws_secret_access_key=PLACEHOLDER_SECRET_KEY;token=PLACEHOLDER_TOKEN'' )');
----
<!REGEX>:(?s).*PLACEHOLDER_.*

statement error
SELECT * FROM redshift_query('rs', 'UNLOAD (''SELECT 1'') TO ''s3://placeholder-bucket/prefix'' CREDENTIALS ''aws_iam_role=placeholder;aws_secret_access_key=PLACEHOLDER_SECRET_KEY;token=PLACEHOLDER_TOKEN'' )');
----
<REGEX>:(?s)Binder Error: Redshift refused the statement: ERROR:  syntax error at or near "\)" in context "[^\n]* CREDENTIALS 'aws_iam_role=placeholder;aws_secret_access_key=<redacted>;token=<redacted>\nSQLSTATE: 42601\n\nLINE 1: .*

statement error
SELECT * FROM redshift_query('rs', 'UNLOAD (''SELECT 1'') TO ''s3://placeholder-bucket/prefix'' CREDENTIALS ''aws_iam_role=placeholder;master_symmetric_key=PLACEHOLDER_MASTER_KEY'' )');
----
<!REGEX>:(?s).*PLACEHOLDER_.*

statement error
SELECT * FROM redshift_query('rs', 'UNLOAD (''SELECT 1'') TO ''s3://placeholder-bucket/prefix'' CREDENTIALS ''aws_iam_role=placeholder;master_symmetric_key=PLACEHOLDER_MASTER_KEY'' )');
----
<REGEX>:(?s)Binder Error: Redshift refused the statement: ERROR:  syntax error at or near "\)" in context "[^\n]* CREDENTIALS 'aws_iam_role=placeholder;master_symmetric_key=<redacted>\nSQLSTATE: 42601\n\nLINE 1: .*

statement error
SELECT * FROM redshift_query('rs', 'UNLOAD (''SELECT 1'') TO ''s3://placeholder-bucket/prefix'' MASTER_SYMMETRIC_KEY ''PLACEHOLDER_MASTER_KEY'' )');
----
<!REGEX>:(?s).*PLACEHOLDER_.*

statement error
SELECT * FROM redshift_query('rs', 'UNLOAD (''SELECT 1'') TO ''s3://placeholder-bucket/prefix'' MASTER_SYMMETRIC_KEY ''PLACEHOLDER_MASTER_KEY'' )');
----
<REGEX>:(?s)Binder Error: Redshift refused the statement: ERROR:  Client side encryption is deprecated for UNLOAD command\nSQLSTATE: 0A000\n\nLINE 1: .*

# A known limit: a literal nothing closes is the token the server's message names, bare, with
# no keyword before it, so it shows there; its "in context" echo, after the keyword, is redacted.
statement error
SELECT * FROM redshift_query('rs', 'COPY placeholder_table FROM ''s3://placeholder-bucket/key'' MASTER_SYMMETRIC_KEY ''PLACEHOLDER_UNCLOSED');
----
<REGEX>:(?s)Binder Error: Redshift refused the statement: ERROR:  unterminated quoted string at or near "'PLACEHOLDER_UNCLOSED" in context "[^\n]* MASTER_SYMMETRIC_KEY '<redacted>'\nSQLSTATE: 42601\n\nLINE 1: .*

# No log line but DuckDB's own query log holds a canary; the extension logs no line for a refused
# statement, and this guards against one that would. The query log holds the caller's SQL as written, one
# line per statement above with a canary (21): the positive control that the log saw them all. This
# query's own line holds one too once DuckDB flushes it, so the count leaves out lines that name
# duckdb_logs.
query III
SELECT count(*) FILTER (type IS DISTINCT FROM 'QueryLog' AND contains(message, 'PLACEHOLDER_')),
       count(*) FILTER (log_level = 'DEBUG') > 0,
       count(*) FILTER (type = 'QueryLog' AND contains(message, 'PLACEHOLDER_')
                        AND NOT contains(message, 'duckdb_logs')) = 21
FROM duckdb_logs;
----
0	true	true
