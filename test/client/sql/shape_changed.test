# name: test/client/sql/shape_changed.test
# description: live: after an ALTER TABLE between a SELECT *'s Describe and its Execute, the Execute is refused before it runs
# group: [sql]

require-env REDSHIFT_TEST_CLIENT odbc

# Live only (test/README.md, "Live variables"): it needs REDSHIFT_TEST_LIVE_REGION and a build with
# the embedded driver.
require-env REDSHIFT_TEST_LIVE_REGION

# The account-backed workgroup the live tests reach (test/README.md, "Live variables").
require-env REDSHIFT_TEST_LIVE_WORKGROUP

require-env REDSHIFT_TEST_LIVE_ACCOUNT_ID

require redshift

statement ok
ATTACH '' AS rs (TYPE redshift, REGION '{REDSHIFT_TEST_LIVE_REGION}', CREDENTIAL_PROVIDER aws_default_chain, WORKGROUP '{REDSHIFT_TEST_LIVE_WORKGROUP}', ACCOUNT_ID '{REDSHIFT_TEST_LIVE_ACCOUNT_ID}');

# Every write is to a temporary table in the attached connection's session.
statement ok
SELECT * FROM redshift_query('rs', 'CREATE TEMP TABLE shape_changed_rows (a INTEGER)');

statement ok
SELECT * FROM redshift_query('rs', 'INSERT INTO shape_changed_rows VALUES (1)');

# PREPARE describes the SELECT * with one column; the EXECUTE comes after the table gains a second.
statement ok
PREPARE read_rows AS SELECT * FROM redshift_query('rs', 'SELECT * FROM shape_changed_rows');

statement ok
SELECT * FROM redshift_query('rs', 'ALTER TABLE shape_changed_rows ADD COLUMN b INTEGER');

# The client refuses the new shape before it runs, since the server itself runs such a statement
# without error. Only the client's part of the message is pinned; the runner adds a newline before it
# full-matches.
statement error
EXECUTE read_rows;
----
<REGEX>:(?s)Binder Error: redshift_query: .*The client reported: the statement's result shape is not the one it was bound with, so it was not run: it was bound with 1 column and now has 2\n.*

# The handle stays usable, and a statement bound now gets the new columns.
query II
SELECT * FROM redshift_query('rs', 'SELECT * FROM shape_changed_rows');
----
1	NULL
