# name: test/client/sql/utf8_text_constants.test
# description: live: multibyte and 4-byte UTF-8 constants arrive unchanged over a row array, and a 4-byte one across two SQLGetData reads
# group: [sql]

require-env REDSHIFT_TEST_CLIENT odbc

# Live only (test/README.md, "Live variables"): it needs REDSHIFT_TEST_LIVE_REGION and a build with
# the embedded driver.
require-env REDSHIFT_TEST_LIVE_REGION

# The account-backed workgroup the live tests reach (test/README.md, "Live variables").
require-env REDSHIFT_TEST_LIVE_WORKGROUP

require-env REDSHIFT_TEST_LIVE_ACCOUNT_ID

require redshift

statement ok
ATTACH '' AS rs (TYPE redshift, REGION '{REDSHIFT_TEST_LIVE_REGION}', CREDENTIAL_PROVIDER aws_default_chain, WORKGROUP '{REDSHIFT_TEST_LIVE_WORKGROUP}', ACCOUNT_ID '{REDSHIFT_TEST_LIVE_ACCOUNT_ID}');

# The server builds the text from its bytes, so only the fetch decides what arrives: a, U+00E9,
# U+20AC, U+1F600 and z. A result is bound over a row array only when every column in it is bounded,
# so each column is read alone: a varchar(300) over a row array, a varchar(65535) with SQLGetData.
# Constants cast to a column's type, so a principal that may not write runs this file; the leader node
# prints them, and utf8_text.test reads the same text stored.
query T
SELECT hex(bounded) FROM redshift_query('rs', 'SELECT CAST(FROM_VARBYTE(FROM_HEX(''61C3A9E282ACF09F98807A''), ''utf8'') AS VARCHAR(300)) AS bounded');
----
61C3A9E282ACF09F98807A

# U+1F600 after 4093 letters, across two reads. PART_BYTES (4096, odbc_statement.cpp) splits it: a
# text part holds 4095 bytes and its NUL, so two of its four bytes come in each read. A change to
# PART_BYTES must move the 4093.
query IT
SELECT strlen(long), hex(substr(long, 4094)) FROM redshift_query('rs', 'SELECT CAST(REPEAT(''a'', 4093) || FROM_VARBYTE(FROM_HEX(''F09F98807A''), ''utf8'') AS VARCHAR(65535)) AS long');
----
4098	F09F98807A
