# name: test/client/sql/credentials.test
# description: live: the driver signs in with the default credential chain or a named profile, the chain still signs in as its own user after a profile has, and a profile that resolves nothing is refused
# group: [sql]

# Live only (test/README.md, "Live variables"). redshift_query connects with its handle's credential
# provider, so each ATTACH below picks the credentials its queries sign in with.
require-env REDSHIFT_TEST_CLIENT odbc

require-env REDSHIFT_TEST_LIVE_REGION

# The account-backed workgroup the live tests reach (test/README.md, "Live variables").
require-env REDSHIFT_TEST_LIVE_WORKGROUP

require-env REDSHIFT_TEST_LIVE_ACCOUNT_ID

require-env REDSHIFT_TEST_LIVE_DEFAULT_USER

require-env REDSHIFT_TEST_LIVE_PROFILE

require-env REDSHIFT_TEST_LIVE_PROFILE_USER

require redshift

# The two users must differ, or the profile cases would pass with either user.
query T
SELECT '{REDSHIFT_TEST_LIVE_DEFAULT_USER}' <> '{REDSHIFT_TEST_LIVE_PROFILE_USER}';
----
true

statement ok
ATTACH '' AS rs_chain (TYPE redshift, REGION '{REDSHIFT_TEST_LIVE_REGION}', CREDENTIAL_PROVIDER aws_default_chain, WORKGROUP '{REDSHIFT_TEST_LIVE_WORKGROUP}', ACCOUNT_ID '{REDSHIFT_TEST_LIVE_ACCOUNT_ID}');

statement ok
ATTACH '' AS rs_named (TYPE redshift, REGION '{REDSHIFT_TEST_LIVE_REGION}', CREDENTIAL_PROVIDER profile, PROFILE '{REDSHIFT_TEST_LIVE_PROFILE}', WORKGROUP '{REDSHIFT_TEST_LIVE_WORKGROUP}', ACCOUNT_ID '{REDSHIFT_TEST_LIVE_ACCOUNT_ID}');

# A profile that resolves nothing fails the ATTACH, whose open finds no credentials.
statement error
ATTACH '' AS rs_missing (TYPE redshift, REGION '{REDSHIFT_TEST_LIVE_REGION}', CREDENTIAL_PROVIDER profile, PROFILE 'duckdb-redshift-test-no-such-profile', WORKGROUP '{REDSHIFT_TEST_LIVE_WORKGROUP}', ACCOUNT_ID '{REDSHIFT_TEST_LIVE_ACCOUNT_ID}');
----
no usable AWS credentials were found through the AWS credential chain

query T
SELECT * FROM redshift_query('rs_chain', 'SELECT CAST(current_user AS VARCHAR(128)) AS db_user');
----
{REDSHIFT_TEST_LIVE_DEFAULT_USER}

query T
SELECT * FROM redshift_query('rs_named', 'SELECT CAST(current_user AS VARCHAR(128)) AS db_user');
----
{REDSHIFT_TEST_LIVE_PROFILE_USER}

# A new default-chain connection after the profile signed in still signs in as the chain's own
# user.
query T con2
SELECT * FROM redshift_query('rs_chain', 'SELECT CAST(current_user AS VARCHAR(128)) AS db_user');
----
{REDSHIFT_TEST_LIVE_DEFAULT_USER}

