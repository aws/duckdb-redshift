# name: test/client/sql/target_not_found.test
# description: live: a workgroup the account does not have gives the not-found message with the workgroup's availability hint
# group: [sql]

require-env REDSHIFT_TEST_CLIENT odbc

# Live only (test/README.md, "Live variables"): it needs REDSHIFT_TEST_LIVE_REGION and a build with
# the embedded driver.
require-env REDSHIFT_TEST_LIVE_REGION

# The account-backed workgroup the live tests reach (test/README.md, "Live variables"); this test
# names another workgroup in its account.
require-env REDSHIFT_TEST_LIVE_WORKGROUP

require-env REDSHIFT_TEST_LIVE_ACCOUNT_ID

require redshift

# GetCredentials answers ResourceNotFoundException, which the availability classifier reads.
# The runner adds a newline before it full-matches.
statement error
ATTACH '' AS rs_missing (TYPE redshift, REGION '{REDSHIFT_TEST_LIVE_REGION}', CREDENTIAL_PROVIDER aws_default_chain, WORKGROUP 'duckdb-redshift-test-no-such-workgroup', ACCOUNT_ID '{REDSHIFT_TEST_LIVE_ACCOUNT_ID}');
----
<REGEX>:(?s)IO Error: Cannot attach rs_missing: Could not connect to Redshift at [^\n]*workgroup duckdb-redshift-test-no-such-workgroup[^\n]*: the Redshift workgroup was not found\.\nThe Redshift Serverless workgroup may not exist or may not be available to the account; check WORKGROUP, ACCOUNT_ID and REGION\.\nSQLSTATE: HY000\n.*

# The positive control: the same credentials reach the live workgroup, so only the name was missing.
statement ok
ATTACH '' AS rs (TYPE redshift, REGION '{REDSHIFT_TEST_LIVE_REGION}', CREDENTIAL_PROVIDER aws_default_chain, WORKGROUP '{REDSHIFT_TEST_LIVE_WORKGROUP}', ACCOUNT_ID '{REDSHIFT_TEST_LIVE_ACCOUNT_ID}');

query I
SELECT * FROM redshift_query('rs', 'SELECT 1');
----
1
