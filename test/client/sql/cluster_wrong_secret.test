# name: test/client/sql/cluster_wrong_secret.test
# description: live: on the provisioned cluster, a wrong secret key gives the credentials error, and shows no key material
# group: [sql]

# Live only, in a process whose environment holds a working access key ID, and its session token
# if it has one, with this placeholder as the secret key (test/README.md, "Live variables"). The
# chain reads the environment first, so the file never signs in with a real secret key.
require-env REDSHIFT_TEST_CLIENT odbc

require-env AWS_ACCESS_KEY_ID

require-env AWS_SECRET_ACCESS_KEY placeholder-wrong-secret-key

require-env REDSHIFT_TEST_LIVE_REGION

# The provisioned cluster the live tests reach (test/README.md, "Live variables").
require-env REDSHIFT_TEST_LIVE_CLUSTER

require redshift

# An exported but empty key ID gives the chain's environment step nothing, so the chain would go on
# to a profile or a role, or find nothing and give this same message without trying the wrong key.
query T
SELECT '{AWS_ACCESS_KEY_ID}' <> '';
----
true

# The cluster's credentials request, GetClusterCredentialsWithIAM, answers SignatureDoesNotMatch,
# which gives the refused-credentials message, as credentials_wrong_secret.test's record does. A
# regex takes no {} variables, so the target in parentheses is any text. This block holds only with
# the next, which checks that no key material, such as a key ID or a token, and none of the driver's
# own text shows.
statement error
ATTACH '' AS rs (TYPE redshift, REGION '{REDSHIFT_TEST_LIVE_REGION}', CREDENTIAL_PROVIDER aws_default_chain, CLUSTER '{REDSHIFT_TEST_LIVE_CLUSTER}');
----
<REGEX>:(?s)IO Error: Cannot attach rs: Could not connect to Redshift at [^\n]* \([^\n]*\): the AWS credentials found through the AWS credential chain were refused or have expired\.\nCheck the credentials this process can reach: the default AWS credential chain, or the profile PROFILE names\.\nSQLSTATE: HY000\n.*

statement error
ATTACH '' AS rs (TYPE redshift, REGION '{REDSHIFT_TEST_LIVE_REGION}', CREDENTIAL_PROVIDER aws_default_chain, CLUSTER '{REDSHIFT_TEST_LIVE_CLUSTER}');
----
<!REGEX>:(?s).*(placeholder-wrong-secret-key|AKIA|ASIA|[A-Za-z0-9/+=]{40,}|[Ss]ignature|IAMConnectionError).*
