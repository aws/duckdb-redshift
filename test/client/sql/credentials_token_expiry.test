# name: test/client/sql/credentials_token_expiry.test
# description: live: a session outlives its database token, and a new connection signs in again, with the default chain and a named profile
# group: [sql]

# Live only, and it takes over an hour (test/README.md, "Live variables"). The sessions are told
# apart by the server's process ID: redshift_query runs on the session its handle keeps for each
# DuckDB connection, so con2 opens new ones.
require-env REDSHIFT_TEST_CLIENT odbc

require-env REDSHIFT_TEST_LIVE_REGION

# The account-backed workgroup the live tests reach (test/README.md, "Live variables").
require-env REDSHIFT_TEST_LIVE_WORKGROUP

require-env REDSHIFT_TEST_LIVE_ACCOUNT_ID

require-env REDSHIFT_TEST_LIVE_PROFILE

require-env REDSHIFT_TEST_LIVE_TOKEN_EXPIRY 1

require redshift

statement ok
ATTACH '' AS rs_chain (TYPE redshift, REGION '{REDSHIFT_TEST_LIVE_REGION}', CREDENTIAL_PROVIDER aws_default_chain, WORKGROUP '{REDSHIFT_TEST_LIVE_WORKGROUP}', ACCOUNT_ID '{REDSHIFT_TEST_LIVE_ACCOUNT_ID}');

statement ok
ATTACH '' AS rs_named (TYPE redshift, REGION '{REDSHIFT_TEST_LIVE_REGION}', CREDENTIAL_PROVIDER profile, PROFILE '{REDSHIFT_TEST_LIVE_PROFILE}', WORKGROUP '{REDSHIFT_TEST_LIVE_WORKGROUP}', ACCOUNT_ID '{REDSHIFT_TEST_LIVE_ACCOUNT_ID}');

statement ok
CREATE TABLE chain_session AS SELECT pid FROM redshift_query('rs_chain', 'SELECT pg_backend_pid() AS pid');

statement ok
CREATE TABLE named_session AS SELECT pid FROM redshift_query('rs_named', 'SELECT pg_backend_pid() AS pid');

# Seven rounds of nine minutes, 3,780 seconds in all. The driver's serverless request sets no
# duration (iam/RsIamClient.cpp SendCredentialsRequest), so the token lasts the GetCredentials
# default, and 3,780 seconds is longer than the most that API allows, 3,600. Each round ends with a
# statement on each session, so that neither sits idle for the whole wait.
loop round 0 7

sleep 540 seconds

query I
SELECT count(*) FROM chain_session, redshift_query('rs_chain', 'SELECT pg_backend_pid() AS pid') later
WHERE later.pid = chain_session.pid;
----
1

query I
SELECT count(*) FROM named_session, redshift_query('rs_named', 'SELECT pg_backend_pid() AS pid') later
WHERE later.pid = named_session.pid;
----
1

endloop

# A new DuckDB connection opens new sessions.
query I con2
SELECT count(*) FROM chain_session, redshift_query('rs_chain', 'SELECT pg_backend_pid() AS pid') later
WHERE later.pid = chain_session.pid;
----
0

query I con2
SELECT count(*) FROM named_session, redshift_query('rs_named', 'SELECT pg_backend_pid() AS pid') later
WHERE later.pid = named_session.pid;
----
0
