# name: test/client/sql/credentials_empty_chain.test
# description: live: a default credential chain that resolves nothing gives the credentials error
# group: [sql]

# Live only, in a process whose default AWS credential chain finds no credentials (test/README.md,
# "Live variables").
require-env REDSHIFT_TEST_CLIENT odbc

require-env REDSHIFT_TEST_LIVE_EMPTY_CHAIN_REGION

require redshift

statement error
ATTACH '' AS rs (TYPE redshift, REGION '{REDSHIFT_TEST_LIVE_EMPTY_CHAIN_REGION}', CREDENTIAL_PROVIDER aws_default_chain, WORKGROUP 'analytics', ACCOUNT_ID '012345678901');
----
no usable AWS credentials were found through the AWS credential chain
