# name: test/client/driver/sql/odbcini_variable.test
# description: a set ODBCINI stops the connection after the load, before the driver's first environment handle (run-e2e.sh)
# group: [sql]

require-env REDSHIFT_TEST_CLIENT odbc

require-env DUCKDB_REDSHIFT_TEST_E2E odbcini-variable

# Only with run-e2e.sh's fake keys and no session token, so a unit tester started by hand on a host with a
# network cannot connect with the caller's own credentials (CREDENTIAL_PROVIDER aws_default_chain, with no PROFILE,
# takes the keys from the environment first).
require-env AWS_ACCESS_KEY_ID test-not-a-key

require-env AWS_SECRET_ACCESS_KEY test-not-a-secret

require-env-not AWS_SESSION_TOKEN

require redshift

# run-e2e.sh starts this with ODBCINI naming a file: it would choose the file the driver reads at its first
# environment handle, so the client's check refuses it before that handle is allocated (a handle-phase name).
statement error
ATTACH '' AS rs (TYPE redshift, REGION 'us-east-1', CREDENTIAL_PROVIDER aws_default_chain, WORKGROUP 'analytics', ACCOUNT_ID '012345678901')
----
IO Error: Cannot attach rs: ODBCINI is set; the Redshift driver would read it, and it can change the driver's connection or security settings. Unset it to connect.
